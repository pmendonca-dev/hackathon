# AVAL — configuração de produção.
#
# Copie para `.env.production` e preencha. Esse arquivo é ignorado pelo git: este
# device é o centralizador, e é aqui que os segredos vivem.
#
#   Copy-Item .env.example .env.production
#   .\scripts\production\new-secrets.ps1     # sorteia os valores fortes
#
# ─── Identidade criptográfica ────────────────────────────────────────────────
# A semente que faz as chaves desta instância sobreviverem a um restart. Sem ela
# cada boot sorteia chaves novas enquanto o banco continua guardando a metade
# pública antiga — e toda compra depois disso morre com `signature_invalid`.
# Trocar esta semente invalida as identidades já registradas no banco.
AVAL_CUSTODY_SEED=

# Habilita a autoridade de revogação do operador e fixa a chave dela. É uma
# decisão de autoridade, por isso mora numa variável própria: uma implantação
# que só queria chaves estáveis não pode ganhar um operador que revoga mandato.
# Deixe vazio para manter essa autoridade desligada.
AVAL_OPERATOR_AUTHORITY_SEED=

# HMAC dos identificadores pairwise (um comprador, um nome diferente em cada
# vendedor). Vazio = sorteado por processo, e os handles morrem no restart.
AVAL_PAIRWISE_SECRET=

# ─── Credenciais ─────────────────────────────────────────────────────────────
# Guarda /agents, /admin/psp, /reconcile, o relógio e as demos destrutivas.
# Vazio = superfícies de operador fechadas.
AVAL_OPERATOR_TOKEN=

# Login de cada papel no navegador. Vazio = aquele papel não entra.
AVAL_UI_HOLDER_CREDENTIAL=
AVAL_UI_MERCHANT_CREDENTIAL=
AVAL_UI_AUDITOR_CREDENTIAL=
AVAL_UI_OPERATOR_CREDENTIAL=

# ─── Rede e armazenamento ────────────────────────────────────────────────────
AVAL_DATABASE_PATH=var/aval.db
AVAL_HOST=127.0.0.1
AVAL_PORT=8099

# Exatamente as origens permitidas — nomear aqui EXCLUI os defaults de dev.
# A SPA é servida same-origin pelo próprio FastAPI, então normalmente basta a
# URL pública do túnel.
AVAL_ALLOWED_ORIGINS=

# Só para uma demonstração em HTTP puro no localhost: afrouxa o cookie `Secure`.
# Numa URL pública com HTTPS, deixe vazio.
AVAL_UI_LOCAL_HTTP=

# ─── Demonstrações destrutivas ───────────────────────────────────────────────
# Sem a variável o router nem é montado: 404 de verdade, ausente do OpenAPI.
# Ligadas, ainda exigem o token de operador por cima.
AVAL_DEMO_TAMPER=1
AVAL_DEMO_ROGUE=1

# ─── Agente por LLM (opcional) ───────────────────────────────────────────────
# Sem as duas, o agente decide por regras e a demo inteira funciona.
AVAL_LLM_AGENT=
ANTHROPIC_API_KEY=
AVAL_LLM_MODEL=
AVAL_LLM_TIMEOUT_SECONDS=8

# ─── Bot do Telegram (opcional) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPEN_MODE=1
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_IDENTITY_PATH=var/telegram-identities.json
